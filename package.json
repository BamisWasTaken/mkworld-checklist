{
  "name": "mkworld-checklist",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start:angular": "ng serve --configuration angular --hmr false",
    "start:wrangler": "npm run build && wrangler dev",
    "build": "ng build",
    "build:angular": "ng build --configuration angular",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "e2e": "playwright test",
    "serve:ssr:mkworld-checklist": "node dist/server/server.mjs",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,scss,html}\"",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"vitest-base.config.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"vitest-base.config.ts\"",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.1.0",
    "panzoom": "^9.4.4",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
