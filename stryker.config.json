{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Scoped to the pure logic modules. Stryker drives Vitest directly, without the Angular builder that compiles components and services, so anything needing TestBed stays on `ng test`.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "mutate": [
    "src/app/sticker-album/sticker-album-layout.ts",
    "src/app/map-section/map-section-geometry.ts",
    "src/app/todo-section/todo-section-items.ts",
    "src/app/map-section/models/quad-tree-node.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  },
  "timeoutMS": 20000,
  "tempDirName": ".stryker-tmp"
}
